{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=breezy;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-minimum-32-characters",
    "Issuer": "Breezy",
    "Audience": "BreezyUsers"
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/breezy-.log", "rollingInterval": "Day" } }
    ]
  }
}